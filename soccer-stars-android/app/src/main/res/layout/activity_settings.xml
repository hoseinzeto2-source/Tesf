<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیمات ابزار"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="طول خط‌کش"
            android:textColor="#C8D0D8" />

        <com.google.android.material.slider.Slider
            android:id="@+id/rulerSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="120"
            android:valueTo="420"
            android:stepSize="10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="کیفیت تشخیص (بیشتر = دقیق‌تر ولی سنگین‌تر)"
            android:textColor="#C8D0D8" />

        <com.google.android.material.slider.Slider
            android:id="@+id/scaleSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.25"
            android:valueTo="1.0"
            android:stepSize="0.05" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showPuckSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="نمایش مسیر مهره"
            android:textColor="#FFFFFF" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showLegendSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نمایش راهنمای رنگ‌ها"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="فایل فیزیک: /sdcard/SoccerStarsAssist/physics.json"
            android:textColor="#888888"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ذخیره" />
    </LinearLayout>
</ScrollView>
